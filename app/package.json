{
  "name": "@hous3-digital/vesta-sdk",
  "version": "2.3.0-staging.1",
  "description": "SKD Vesta para integração com a API da Vesta",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "prebuild": "node scripts/generate-privy-config.js",
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/bundle-privy.js",
    "pretest": "node scripts/generate-privy-config.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src __test__ --ext .ts",
    "lint:fix": "eslint src __test__ --ext .ts --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hous3-digital/vesta-sdk.git"
  },
  "keywords": [],
  "author": "Hous3 Digital",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/hous3-digital/vesta-sdk/issues"
  },
  "homepage": "https://github.com/hous3-digital/vesta-sdk#readme",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@privy-io/js-sdk-core": "0.68.4",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0",
    "esbuild": "^0.25.12",
    "globals": "^17.6.0",
    "fake-indexeddb": "^4.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^6.0.3",
    "viem": "2.55.5"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "public"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "16.2.0"
  },
  "resolutions": {
    "axios": ">=1.16.0",
    "ws": ">=8.21.0",
    "uuid": ">=11.0.0"
  }
}
